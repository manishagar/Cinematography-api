<?xml version="1.0" encoding="UTF-8"?>
<!--
  DSG‑APIS Parent / Aggregator POM
  Goals:
    - Centralize dependency & plugin versions for all microservices.
    - Align Spring Boot + Spring Cloud BOMs across modules.
    - Provide secure org-wide defaults (HttpClient 5, commons-configuration2, etc.).
    - Prevent inclusion of vulnerable dependencies using Maven Enforcer (direct usages).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <!-- Aggregator coordinates -->
  <groupId>com.cinematography</groupId>
  <artifactId>cinematography</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>Cinematography</name>
  <description>Parent project for all Cinematography APIs</description>

  <!-- Centralized versions -->
  <properties>
    <!-- Java & Compiler -->
    <java.version>17</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>${java.version}</maven.compiler.source>
    <maven.compiler.target>${java.version}</maven.compiler.target>
    <maven.compiler.plugin.version>3.16.0</maven.compiler.plugin.version>
    <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
    <maven.jar.plugin.version>3.5.1</maven.jar.plugin.version>
    <maven.resources.plugin.version>3.5.0</maven.resources.plugin.version>


    <!-- Framework BOM versions -->
    <spring.boot.version>4.0.8</spring.boot.version>
    <spring.cloud.version>2025.1.3</spring.cloud.version>

    <!-- Library versions -->
    <jjwt.version>0.13.0</jjwt.version>
    <springdoc.version>3.0.3</springdoc.version>

    <!-- Org-wide pins -->
    <httpclient5.version>5.6.4</httpclient5.version>
    <!-- Must track httpclient5: 5.6.x needs httpcore5 5.4.x for
          org.apache.hc.core5.io.IOFunction. The Spring Boot BOM pins httpcore5 to the
          5.3.x line that matches its own httpclient5 5.5.2, so pinning httpclient5
          without this leaves the two skewed and every Eureka registry fetch fails
          with NoClassDefFoundError. -->
    <httpcore5.version>5.4.3</httpcore5.version>
    <commons.configuration2.version>2.15.1</commons.configuration2.version>
    <freemarker.version>2.3.35</freemarker.version>
    <!-- SQL Server JDBC driver: pinned centrally. Previously each module chose its own,
          three of them via an unbounded range [13.2.0,) which made builds non-reproducible. -->
    <mssql.jdbc.version>13.6.0.jre11</mssql.jdbc.version>
    <!-- Legacy HttpClient 4.x: required only by service-registry (Eureka replication). -->
    <httpclient4.version>4.5.14</httpclient4.version>
    <dompurify.version>3.4.15</dompurify.version>
    <caffeine.version>3.2.4</caffeine.version>
    <!-- CVE overrides for versions shipped by Spring Boot 4.0.8 (latest 4.0.x).
          Tomcat 11.0.24: CVE-2026-65182/65183/65637/65905/65927/66299/66422/68525/68569/68763/73180 (fixed 11.0.25).
          Netty 4.2.17: CVE-2026-89044 (fixed 4.2.18). Remove once the Boot BOM catches up. -->
    <tomcat.version>11.0.27</tomcat.version>
    <netty.version>4.2.19.Final</netty.version>
    <lombok.version>1.18.46</lombok.version> <!-- Lombok managed centrally -->

    <!-- Build plugin versions -->
    <maven-surefire.version>3.6.0</maven-surefire.version>
    <sonar.version>5.8.0.7211</sonar.version>

    <!-- Other -->
    <skipTests>false</skipTests>
    <jsr305.version>3.0.2</jsr305.version>
  </properties>

  <!-- Manage versions only (children declare GAVs without <version>) -->
  <dependencyManagement>
    <dependencies>
      <!-- Shared internal libraries (code used by more than one service) -->
      <dependency>
        <groupId>com.cinematography</groupId>
        <artifactId>cinematography-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.cinematography</groupId>
        <artifactId>cinematography-web</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.cinematography</groupId>
        <artifactId>cinematography-cust</artifactId>
        <version>${project.version}</version>
      </dependency>

      <!-- OpenAPI JSON generation only; Swagger UI intentionally excluded in production -->
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
      <!-- WebFlux variant for reactive modules (e.g. api-gateway) -->
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webflux-api</artifactId>
        <version>${springdoc.version}</version>
      </dependency>

      <!-- Netty BOM: imported before the Spring Boot BOM so its versions take precedence -->
      <dependency>
        <groupId>io.netty</groupId>
        <artifactId>netty-bom</artifactId>
        <version>${netty.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- Embedded Tomcat: explicit entries override the Spring Boot BOM -->
      <dependency>
        <groupId>org.apache.tomcat.embed</groupId>
        <artifactId>tomcat-embed-core</artifactId>
        <version>${tomcat.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.tomcat.embed</groupId>
        <artifactId>tomcat-embed-el</artifactId>
        <version>${tomcat.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.tomcat.embed</groupId>
        <artifactId>tomcat-embed-websocket</artifactId>
        <version>${tomcat.version}</version>
      </dependency>

      <!-- Spring Boot BOM -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring.boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- Spring Cloud BOM -->
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring.cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- HttpClient 5 (modern API) -->
      <dependency>
        <groupId>org.apache.httpcomponents.client5</groupId>
        <artifactId>httpclient5</artifactId>
        <version>${httpclient5.version}</version>
      </dependency>

      <!-- HttpCore 5, kept in lockstep with httpclient5 above -->
      <dependency>
        <groupId>org.apache.httpcomponents.core5</groupId>
        <artifactId>httpcore5</artifactId>
        <version>${httpcore5.version}</version>
      </dependency>

      <dependency>
        <groupId>org.apache.httpcomponents.core5</groupId>
        <artifactId>httpcore5-h2</artifactId>
        <version>${httpcore5.version}</version>
      </dependency>

      <!-- Commons‑Configuration 2.x (safe line) -->
      <dependency>
        <groupId>org.apache.commons</groupId>
        <artifactId>commons-configuration2</artifactId>
        <version>${commons.configuration2.version}</version>
      </dependency>

      <dependency>
        <groupId>org.freemarker</groupId>
        <artifactId>freemarker</artifactId>
        <version>${freemarker.version}</version>
      </dependency>
      <!-- Caffeine cache -->
      <dependency>
        <groupId>com.github.ben-manes.caffeine</groupId>
        <artifactId>caffeine</artifactId>
        <version>${caffeine.version}</version>
      </dependency>

      <!-- Lombok (managed to avoid version overrides in children) -->
      <dependency>
        <groupId>org.projectlombok</groupId>
        <artifactId>lombok</artifactId>
        <version>${lombok.version}</version>
      </dependency>

      <!-- JJWT: manage all artifacts here -->
      <dependency>
        <groupId>io.jsonwebtoken</groupId>
        <artifactId>jjwt-api</artifactId>
        <version>${jjwt.version}</version>
      </dependency>
      <dependency>
        <groupId>io.jsonwebtoken</groupId>
        <artifactId>jjwt-impl</artifactId>
        <version>${jjwt.version}</version>
      </dependency>
      <dependency>
        <groupId>io.jsonwebtoken</groupId>
        <artifactId>jjwt-jackson</artifactId>
        <version>${jjwt.version}</version>
      </dependency>

      <!-- JSR 305 annotations -->
      <dependency>
        <groupId>com.google.code.findbugs</groupId>
        <artifactId>jsr305</artifactId>
        <version>${jsr305.version}</version>
      </dependency>

      <!-- SQL Server JDBC driver (version pinned above; modules declare scope) -->
      <dependency>
        <groupId>com.microsoft.sqlserver</groupId>
        <artifactId>mssql-jdbc</artifactId>
        <version>${mssql.jdbc.version}</version>
      </dependency>

      <!-- Legacy HttpClient 4.x. Banned by the enforcer everywhere except
            service-registry, whose Eureka replication client requires it. -->
      <dependency>
        <groupId>org.apache.httpcomponents</groupId>
        <artifactId>httpclient</artifactId>
        <version>${httpclient4.version}</version>
      </dependency>

      <!-- DOMPurify WebJar (only if explicitly used) -->
      <dependency>
        <groupId>org.webjars.npm</groupId>
        <artifactId>dompurify</artifactId>
        <version>${dompurify.version}</version>
      </dependency>

    </dependencies>
  </dependencyManagement>

  <!-- Common dependencies inherited by all modules -->
  <dependencies>

    <!-- Spring Boot Core -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>

    <!-- Spring Boot Test -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- REST stacks are deliberately NOT inherited here.
          Declaring both would put Tomcat + Spring MVC on the reactive modules
          (api-gateway, token-api) and force spring.main.web-application-type
          workarounds. Each module declares exactly one:
          servlet/MVC  -> spring-boot-starter-web
          reactive     -> spring-boot-starter-webflux
          Versions still come from the Spring Boot BOM above. -->

    <!-- Spring Cloud -->
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>

      <exclusions>
        <!-- Block legacy HttpClient 4.x -->
        <exclusion>
          <groupId>org.apache.httpcomponents</groupId>
          <artifactId>httpclient</artifactId>
        </exclusion>

        <!-- Block commons-configuration 1.x -->
        <exclusion>
          <groupId>commons-configuration</groupId>
          <artifactId>commons-configuration</artifactId>
        </exclusion>

        <!-- Block commons-jxpath -->
        <exclusion>
          <groupId>commons-jxpath</groupId>
          <artifactId>commons-jxpath</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-loadbalancer</artifactId>
    </dependency>

    <!-- Actuator -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- Security + JWT (versions inherited from dependencyManagement) -->
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Observability: OTel bridge only — no OTLP export needed.
          The OTel SDK (bundled inside micrometer-tracing-bridge-otel) initialises
          a real SdkTracerProvider so traceId/spanId are written to MDC and appear
          in log files without requiring any external collector. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-tracing-bridge-otel</artifactId>
    </dependency>

    <!--Dev
    Tools Spring Boot, Do Not Commit-->
  </dependencies>

  <!-- Build plugins -->
  <build>

    <!-- <service>.yml is filtered so spring.profiles.active gets the Maven profile (-P dv|qa|pp|pd).
         Only @...@ tokens are replaced (see maven-resources-plugin below); ${...} Spring placeholders are left as they are.
         Every other resource (banner, schema, certificates) is copied unfiltered. -->
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>${project.artifactId}.yml</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes>
          <exclude>${project.artifactId}.yml</exclude>
        </excludes>
      </resource>
    </resources>

    <!-- Plugin versions only -->
    <pluginManagement>
      <plugins>

        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring.boot.version}</version>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire.version}</version>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven.compiler.plugin.version}</version>
          <configuration>
            <release>${java.version}</release>
            <annotationProcessorPaths>
              <path>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
              </path>
            </annotationProcessorPaths>
          </configuration>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${maven-enforcer-plugin.version}</version>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven.jar.plugin.version}</version>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>${maven.resources.plugin.version}</version>
        </plugin>

        <plugin>
          <groupId>org.sonarsource.scanner.maven</groupId>
          <artifactId>sonar-maven-plugin</artifactId>
          <version>${sonar.version}</version>
        </plugin>

      </plugins>
    </pluginManagement>

    <!-- Plugins that actually run -->
    <plugins>

      <!-- Resource filtering with @...@ only, so ${...} Spring placeholders in yml are never touched -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <configuration>
          <delimiters>
            <delimiter>@</delimiter>
          </delimiters>
          <useDefaultDelimiters>false</useDefaultDelimiters>
        </configuration>
      </plugin>

      <!-- ONE Enforcer – transitive blocking -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>

        <executions>
          <execution>
            <id>ban-legacy-deps</id>

            <!-- CRITICAL FIX -->
            <phase>verify</phase>

            <goals>
              <goal>enforce</goal>
            </goals>

            <configuration>
              <rules>
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>

                  <excludes>
                    <exclude>commons-jxpath:commons-jxpath</exclude>
                    <exclude>commons-configuration:commons-configuration</exclude>
                    <exclude>org.apache.httpcomponents:httpclient</exclude>

                    <!-- httpclient5 5.6.x needs org.apache.hc.core5.io.IOFunction,
                          added in httpcore5 5.4. The Spring Boot BOM pins httpcore5 to
                          the 5.3.x line, so if the httpcore5.version pin above is ever
                          dropped the two silently skew and every Eureka registry fetch
                          dies at runtime with NoClassDefFoundError. Fail the build instead. -->
                    <exclude>org.apache.httpcomponents.core5:httpcore5:(,5.4)</exclude>
                    <exclude>org.apache.httpcomponents.core5:httpcore5-h2:(,5.4)</exclude>
                    <exclude>org.freemarker:freemarker:(,2.3.35)</exclude>
                  </excludes>
                </bannedDependencies>
              </rules>

              <fail>true</fail>
            </configuration>
          </execution>
        </executions>
      </plugin>

    </plugins>

  </build>

  <!-- Environment profiles -->
  <profiles>
    <profile>
      <id>dv</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <properties>
        <spring.profiles.active>dv</spring.profiles.active>
        <skipTests>true</skipTests>
      </properties>
    </profile>

    <profile>
      <id>qa</id>
      <properties>
        <spring.profiles.active>qa</spring.profiles.active>
      </properties>
    </profile>

    <profile>
      <id>pp</id>
      <properties>
        <spring.profiles.active>pp</spring.profiles.active>
      </properties>
    </profile>

    <profile>
      <id>pd</id>
      <properties>
        <spring.profiles.active>pd</spring.profiles.active>
      </properties>
    </profile>
  </profiles>

  <!-- Child modules -->
  <modules>
    <!-- Shared libraries (plain jars, no repackaging) -->
    <module>cinematography-core</module>
    <module>cinematography-web</module>
    <module>cinematography-cust</module>
    <!-- Services -->
    <module>service-registry</module>
    <module>admin-api</module>
    <module>api-gateway</module>
  </modules>
</project>